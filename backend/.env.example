# ─── PostgreSQL Docker container ─────────────────────────────────────────────
POSTGRES_DB=backend_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# ─── Spring Boot datasource ───────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/backend_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_DAYS=7
JWT_TEMP_EXPIRATION_MS=300000

# ─── Application ──────────────────────────────────────────────────────────────
SERVER_PORT=8080
APP_NAME=Backend
FRONTEND_URL=http://localhost:5173
JPA_DDL_AUTO=update

# ─── Brevo SMTP ───────────────────────────────────────────────────────────────
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=FixItNow
EMAIL_CONFIRMATION_EXPIRATION_HOURS=24
PASSWORD_RESET_EXPIRATION_HOURS=2


SPRING_PROFILES_ACTIVE=dev

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Test-mode secret key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret. For local dev run:
#   stripe listen --forward-to localhost:8080/api/payments/webhook
# and copy the printed whsec_… value here.
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
# Platform commission kept per invoice (percent). Rest is paid to the provider.
STRIPE_APPLICATION_FEE_PERCENT=8

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# ─── Gemini AI ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_MAX_FILE_SIZE_MB=5

